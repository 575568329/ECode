# ECode 环境变量模板
# 复制为 .env 放在启动目录（cwd）使用：
#   - dev（npm run dev）与 serve（ecode serve）都会读 cwd 的 .env
#   - 优先级：进程环境变量（shell export）> .env 文件 > ~/.ecode/config.json > 默认值
#   - 注意：.env 只在**启动目录**生效（不是每层目录都找）；改完重启进程生效
#   - 密钥不落明文习惯：config.json 的 mcpServers/feishu 里可用 ${VAR} 占位符引用这里的变量

# ── Provider 覆盖（对应 providers 配置节；不填则全走 config.json）──────────
# 协议：anthropic | openai
#ECODE_TYPE=anthropic

# Anthropic 兼容端点（跑 GLM 示例）
#ECODE_BASE_URL=https://open.bigmodel.cn/api/anthropic

# API Key（密钥优先环境变量，其次 config.json 的 apiKey）
#ANTHROPIC_API_KEY=

# 默认模型（覆盖 config 的 default.model）
#ECODE_MODEL=glm-5.3-flash

# ── serve（手机/Web 远程访问；详见 docs M12/M13）────────────────────────────
# 绑定地址：默认 127.0.0.1 仅本机；手机访问设 0.0.0.0（或具体局域网 IP）
#ECODE_SERVE_HOST=0.0.0.0

# 非 loopback 绑定时【必须】设置访问密码，否则拒绝启动
#ECODE_SERVER_PASSWORD=

# 端口：默认 0 = 随机端口（每次启动打印实际端口；固定端口便于手机收藏夹）
#ECODE_SERVE_PORT=7777

# Web 前端目录显式覆盖（默认自动找包内 web/dist，无需设置）
#ECODE_WEB_DIR=

# ── TUI 行为 ────────────────────────────────────────────────────────────────
# =1 时禁用备用屏（备用屏模式异常时的逃生门；tmux 下自动跳过）
#ECODE_NO_ALT_SCREEN=1

# ── Windows shell 解析（bash 工具 / hooks 用）──────────────────────────────
# Git Bash 不在常见安装路径且不在 PATH 时，指向 bash.exe 的 Windows 完整路径
#SHELL=D:\tools\Git\bin\bash.exe

# ── 不建议放 .env 的（列此防误配）─────────────────────────────────────────
# 飞书 IM 网关（serve 自动激活）：放 ~/.ecode/config.json 的 feishu 节
#   "feishu": { "appId": "...", "appSecret": "...", "allowUsers": ["xxx"] }
