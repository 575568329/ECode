# ============================================================
# ECode M2 模型配置（配合 ~/.ecode/config.json 使用）
# ============================================================
# 复制本文件为 .env，填入你用的 provider 的 key（.env 已被 gitignore，不会提交）。
#
# M2 起，模型配置由 ~/.ecode/config.json 驱动（providers/models/capabilities）。
# config.json 里每个 provider 的 apiKeyEnv 指向下面某个变量名——
# 即 key 通过环境变量注入，不在 config.json 里明文存（安全）。
# 不存在 config.json 时用内置默认（GLM/DeepSeek/Claude，对应下方变量名）。

# ---- GLM（智谱，默认模型 glm-5.2）----
# 从 https://open.bigmodel.cn/ 获取
ZHIPUAI_API_KEY=sk-your-glm-key

# ---- DeepSeek（OpenAI 兼容端点）----
# 从 https://platform.deepseek.com/ 获取
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ---- Anthropic Claude（可选）----
# 从 https://console.anthropic.com/ 获取
ANTHROPIC_API_KEY=sk-ant-api03-...

# ------------------------------------------------------------
# 可选：自定义请求地址（baseURL）—— 留空或不写 = 用内置默认
# ECode 的 baseURL 三级优先级（高 → 低）：
#   ① 下方 *_BASE_URL 环境变量  →  .env 灵活切换（临时切代理 / 灰度端点）
#   ② ~/.ecode/config.json 的 providers.X.baseURL  →  长期固定配置
#   ③ 内置默认（GLM 走 coding plan 端点，见 src/providers/config.ts）
# 设了非空 *_BASE_URL 会同时覆盖 config.json 与 SDK 原生的
#   OPENAI_BASE_URL / ANTHROPIC_BASE_URL（后两者不再生效）。
# ------------------------------------------------------------
# GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ------------------------------------------------------------
# 切换默认模型：编辑 ~/.ecode/config.json 的 defaultModel，
# 或运行时 ecode --model <name> "任务"。
# ------------------------------------------------------------
