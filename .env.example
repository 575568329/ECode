# ============================================================
# ECode 模型配置（默认走 DeepSeek 的 Anthropic 兼容端点）
# ============================================================
# 复制本文件为 .env，填入你自己的 key（.env 已被 gitignore，不会提交）
#
# DeepSeek 通过 /anthropic 兼容端点直接支持 Anthropic SDK 协议，
# 所以 ECode 无需改动代码，仅靠下面三个变量即可切换到 DeepSeek。

# DeepSeek API Key（从 https://platform.deepseek.com/ 获取）
# 注意：兼容端点用 AUTH_TOKEN（走 Authorization: Bearer），不是 API_KEY
ANTHROPIC_AUTH_TOKEN=sk-your-deepseek-key

# DeepSeek 的 Anthropic 兼容端点
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 模型名（可选，默认 deepseek-v4-pro）
# DeepSeek 公开模型：deepseek-chat / deepseek-reasoner
# 兼容端点也接受：deepseek-v4-pro / deepseek-v4-flash
ANTHROPIC_MODEL=deepseek-v4-flash

# ------------------------------------------------------------
# 切回官方 Claude 时，注释上面四行，改用：
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# （BASE_URL 留空即走官方 https://api.anthropic.com）
# ------------------------------------------------------------
